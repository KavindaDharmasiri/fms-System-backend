<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ai_rule_simple_summary" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="reportTitle" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["AI Rule Testing Summary"]]></defaultValueExpression>
    </parameter>
    <parameter name="generatedDate" class="java.lang.String" isForPrompting="false"/>
    <parameter name="totalTransactions" class="java.lang.Integer" isForPrompting="false"/>
    <parameter name="flaggedTransactions" class="java.lang.Integer" isForPrompting="false"/>
    <parameter name="averageRiskScore" class="java.lang.Double" isForPrompting="false"/>
    <parameter name="highRiskCount" class="java.lang.Integer" isForPrompting="false"/>
    <parameter name="mediumRiskCount" class="java.lang.Integer" isForPrompting="false"/>
    <parameter name="lowRiskCount" class="java.lang.Integer" isForPrompting="false"/>
    <parameter name="flaggedPercentage" class="java.lang.Double" isForPrompting="false"/>
    <parameter name="totalAmount" class="java.lang.Double" isForPrompting="false"/>
    <parameter name="averageAmount" class="java.lang.Double" isForPrompting="false"/>

    <background>
        <band splitType="Stretch"/>
    </background>

    <title>
        <band height="100" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="10" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[Fraud Management System]]></text>
            </staticText>
            
            <textField>
                <reportElement x="0" y="45" width="555" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="0" y="75" width="555" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated on: " + $P{generatedDate}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <summary>
        <band height="400" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="20" width="555" height="25"/>
                <textElement>
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Executive Summary]]></text>
            </staticText>
            
            <textField>
                <reportElement x="0" y="60" width="275" height="20"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["Total Transactions: " + $P{totalTransactions}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="280" y="60" width="275" height="20"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["Flagged Transactions: " + $P{flaggedTransactions}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="0" y="85" width="275" height="20"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["Average Risk Score: " + $P{averageRiskScore}]]></textFieldExpression>
            </textField>
            
            <textField pattern="#,##0.00'%'">
                <reportElement x="280" y="85" width="275" height="20"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["Flag Rate: " + $P{flaggedPercentage}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="0" y="130" width="555" height="25"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[Risk Level Distribution]]></text>
            </staticText>
            
            <textField>
                <reportElement x="0" y="170" width="185" height="20"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["High Risk: " + $P{highRiskCount}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="185" y="170" width="185" height="20"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["Medium Risk: " + $P{mediumRiskCount}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="370" y="170" width="185" height="20"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["Low Risk: " + $P{lowRiskCount}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="0" y="220" width="555" height="25"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[Financial Impact]]></text>
            </staticText>
            
            <textField pattern="$#,##0.00">
                <reportElement x="0" y="260" width="275" height="20"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["Total Amount: " + $P{totalAmount}]]></textFieldExpression>
            </textField>
            
            <textField pattern="$#,##0.00">
                <reportElement x="280" y="260" width="275" height="20"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["Average Amount: " + $P{averageAmount}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="0" y="320" width="555" height="40"/>
                <textElement textAlignment="Center">
                    <font size="10"/>
                </textElement>
                <text><![CDATA[This report provides a comprehensive overview of AI rule performance and transaction risk assessment. All data is processed according to fraud detection policies and regulatory requirements.]]></text>
            </staticText>
        </band>
    </summary>

    <noData>
        <band height="50">
            <staticText>
                <reportElement x="0" y="10" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[No data available for this report]]></text>
            </staticText>
        </band>
    </noData>

    <pageFooter>
        <band height="30" splitType="Stretch">
            <textField>
                <reportElement x="0" y="10" width="100" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="455" y="10" width="100" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[" of " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="200" y="10" width="155" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <text><![CDATA[Confidential - FMS Internal Use Only]]></text>
            </staticText>
        </band>
    </pageFooter>

</jasperReport>