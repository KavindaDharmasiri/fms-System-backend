<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ai_rule_comprehensive_analysis" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <property name="ireport.zoom" value="1.0"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>

    <parameter name="reportTitle" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["Comprehensive AI Rule Analysis Report"]]></defaultValueExpression>
    </parameter>
    <parameter name="generatedDate" class="java.lang.String" isForPrompting="false"/>
    <parameter name="totalTransactions" class="java.lang.Integer" isForPrompting="false"/>
    <parameter name="flaggedTransactions" class="java.lang.Integer" isForPrompting="false"/>
    <parameter name="averageRiskScore" class="java.lang.Double" isForPrompting="false"/>
    <parameter name="highRiskCount" class="java.lang.Integer" isForPrompting="false"/>
    <parameter name="mediumRiskCount" class="java.lang.Integer" isForPrompting="false"/>
    <parameter name="lowRiskCount" class="java.lang.Integer" isForPrompting="false"/>

    <field name="transactionId" class="java.lang.Long"/>
    <field name="transactionUuid" class="java.lang.String"/>
    <field name="amount" class="java.lang.Double"/>
    <field name="pan" class="java.lang.String"/>
    <field name="originalRiskLevel" class="java.lang.String"/>
    <field name="newRiskLevel" class="java.lang.String"/>
    <field name="firedAIRules" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    <field name="transactionDate" class="java.lang.String"/>
    <field name="riskScore" class="java.lang.Double"/>
    <field name="fraudPercentage" class="java.lang.Double"/>
    <field name="actionStatus" class="java.lang.String"/>
    <field name="blockReason" class="java.lang.String"/>
    <field name="allFiredRules" class="java.lang.String"/>

    <background>
        <band splitType="Stretch"/>
    </background>

    <title>
        <band height="140" splitType="Stretch">
            <!-- Header Background with Gradient Effect -->
            <rectangle>
                <reportElement x="0" y="0" width="555" height="80" backcolor="#0F172A"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            
            <staticText>
                <reportElement x="20" y="15" width="515" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[🛡️ Fraud Management System]]></text>
            </staticText>
            
            <textField>
                <reportElement x="20" y="40" width="515" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="0" y="90" width="555" height="15" forecolor="#64748B"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated on: " + $P{generatedDate}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="0" y="110" width="555" height="25" forecolor="#1E293B"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Detailed Transaction Analysis with AI Rule Explanations]]></text>
            </staticText>
            
            <!-- Decorative Line -->
            <line>
                <reportElement x="0" y="135" width="555" height="2"/>
                <graphicElement>
                    <pen lineWidth="2.0" lineColor="#3B82F6"/>
                </graphicElement>
            </line>
        </band>
    </title>

    <pageHeader>
        <band height="100" splitType="Stretch">
            <!-- Enhanced Summary Statistics -->
            <rectangle>
                <reportElement x="0" y="10" width="555" height="80" backcolor="#F8FAFC"/>
                <graphicElement>
                    <pen lineWidth="2.0" lineColor="#E2E8F0"/>
                </graphicElement>
            </rectangle>
            
            <staticText>
                <reportElement x="15" y="20" width="525" height="18" forecolor="#1E3A8A"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[📊 Analysis Overview]]></text>
            </staticText>
            
            <!-- Metrics Row 1 -->
            <textField>
                <reportElement x="15" y="45" width="120" height="15" forecolor="#374151"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["📈 Total: " + $P{totalTransactions}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="140" y="45" width="120" height="15" forecolor="#DC2626"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["🚨 Flagged: " + $P{flaggedTransactions}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="265" y="45" width="140" height="15" forecolor="#7C3AED"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["⚡ Avg Risk: " + $P{averageRiskScore}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="410" y="45" width="130" height="15" forecolor="#059669"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["✅ Success Rate: " + Math.round((($P{totalTransactions} - $P{flaggedTransactions}) * 100.0 / $P{totalTransactions})) + "%"]]></textFieldExpression>
            </textField>
            
            <!-- Risk Distribution Row -->
            <textField>
                <reportElement x="15" y="65" width="100" height="15" forecolor="#DC2626"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["🔴 High: " + $P{highRiskCount}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="120" y="65" width="100" height="15" forecolor="#D97706"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["🟡 Medium: " + $P{mediumRiskCount}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="225" y="65" width="100" height="15" forecolor="#059669"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["🟢 Low: " + $P{lowRiskCount}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <detail>
        <band height="280" splitType="Stretch">
            <!-- Main Transaction Card -->
            <rectangle>
                <reportElement x="0" y="5" width="555" height="270" backcolor="#FFFFFF"/>
                <graphicElement>
                    <pen lineWidth="2.0" lineColor="#E5E7EB"/>
                </graphicElement>
            </rectangle>
            
            <!-- Transaction Header with Status -->
            <rectangle>
                <reportElement x="0" y="5" width="555" height="30" backcolor="#1E40AF"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            
            <textField>
                <reportElement x="15" y="12" width="200" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["🔍 Transaction #" + $F{transactionId}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="220" y="12" width="180" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["UUID: " + ($F{transactionUuid} != null ? $F{transactionUuid}.substring(0, Math.min(12, $F{transactionUuid}.length())) + "..." : "N/A")]]></textFieldExpression>
            </textField>
            
            <!-- Dynamic Status Badge -->
            <rectangle>
                <reportElement x="470" y="10" width="75" height="16">
                    <printWhenExpression><![CDATA[$F{status}.equals("FLAGGED")]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            <textField>
                <reportElement x="475" y="12" width="65" height="12" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["🚨 " + $F{status}]]></textFieldExpression>
            </textField>
            
            <!-- Transaction Details Section -->
            <staticText>
                <reportElement x="15" y="45" width="525" height="15" forecolor="#1F2937"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[💳 Transaction Information]]></text>
            </staticText>
            
            <textField pattern="$#,##0.00">
                <reportElement x="15" y="65" width="130" height="12" forecolor="#059669"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["💰 Amount: " + $F{amount}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="150" y="65" width="180" height="12" forecolor="#6B7280"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["💳 PAN: " + ($F{pan} != null ? $F{pan}.substring(0, Math.min(4, $F{pan}.length())) + "••••••••" + $F{pan}.substring(Math.max(0, $F{pan}.length()-4)) : "N/A")]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="335" y="65" width="200" height="12" forecolor="#6B7280"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["📅 Date: " + $F{transactionDate}]]></textFieldExpression>
            </textField>
            
            <!-- Risk Assessment Section -->
            <staticText>
                <reportElement x="15" y="85" width="525" height="15" forecolor="#DC2626"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[⚠️ Risk Assessment & Analysis]]></text>
            </staticText>
            
            <!-- Risk Level Comparison -->
            <staticText>
                <reportElement x="15" y="105" width="80" height="12" forecolor="#374151"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Original Risk:]]></text>
            </staticText>
            
            <!-- Original Risk Badge with Dynamic Color -->
            <rectangle>
                <reportElement x="100" y="104" width="55" height="14">
                    <printWhenExpression><![CDATA[$F{originalRiskLevel}.equals("LOW")]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            <rectangle>
                <reportElement x="100" y="104" width="55" height="14" backcolor="#F59E0B">
                    <printWhenExpression><![CDATA[$F{originalRiskLevel}.equals("MEDIUM")]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            <rectangle>
                <reportElement x="100" y="104" width="55" height="14" backcolor="#EF4444">
                    <printWhenExpression><![CDATA[$F{originalRiskLevel}.equals("HIGH")]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            <textField>
                <reportElement x="105" y="105" width="45" height="12" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{originalRiskLevel}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="170" y="105" width="60" height="12" forecolor="#374151"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[➡️ New Risk:]]></text>
            </staticText>
            
            <!-- New Risk Badge with Dynamic Color -->
            <rectangle>
                <reportElement x="235" y="104" width="55" height="14" backcolor="#10B981">
                    <printWhenExpression><![CDATA[$F{newRiskLevel}.equals("LOW")]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            <rectangle>
                <reportElement x="235" y="104" width="55" height="14" backcolor="#F59E0B">
                    <printWhenExpression><![CDATA[$F{newRiskLevel}.equals("MEDIUM")]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            <rectangle>
                <reportElement x="235" y="104" width="55" height="14" backcolor="#EF4444">
                    <printWhenExpression><![CDATA[$F{newRiskLevel}.equals("HIGH")]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            <textField>
                <reportElement x="240" y="105" width="45" height="12" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{newRiskLevel}]]></textFieldExpression>
            </textField>
            
            <!-- Risk Scores -->
            <textField pattern="#,##0.00">
                <reportElement x="305" y="105" width="90" height="12" forecolor="#7C3AED"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["📊 Score: " + $F{riskScore}]]></textFieldExpression>
            </textField>
            
            <textField pattern="#,##0.00'%'">
                <reportElement x="400" y="105" width="140" height="12" forecolor="#DC2626"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["🎯 Fraud Probability: " + $F{fraudPercentage}]]></textFieldExpression>
            </textField>
            
            <!-- AI Rules Analysis Section -->
            <staticText>
                <reportElement x="15" y="125" width="525" height="15" forecolor="#DC2626"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[🤖 AI Rules Triggered & Analysis]]></text>
            </staticText>
            
            <!-- Fired Rules Box with Enhanced Styling -->
            <rectangle>
                <reportElement x="15" y="145" width="525" height="35" backcolor="#FEF2F2"/>
                <graphicElement>
                    <pen lineWidth="2.0" lineColor="#FECACA"/>
                </graphicElement>
            </rectangle>
            
            <staticText>
                <reportElement x="20" y="150" width="80" height="12" forecolor="#991B1B"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[🔥 Fired Rules:]]></text>
            </staticText>
            
            <textField isStretchWithOverflow="true">
                <reportElement x="105" y="150" width="430" height="25" forecolor="#991B1B"/>
                <textElement verticalAlignment="Top">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{firedAIRules} != null && !$F{firedAIRules}.isEmpty() ? $F{firedAIRules} : "✅ No rules fired - Transaction appears legitimate"]]></textFieldExpression>
            </textField>
            
            <!-- Detailed Analysis Section -->
            <staticText>
                <reportElement x="15" y="190" width="525" height="15" forecolor="#1F2937"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[🔍 Detailed Analysis & Reasoning]]></text>
            </staticText>
            
            <!-- Block Reason -->
            <staticText>
                <reportElement x="15" y="210" width="100" height="12" forecolor="#374151"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[🛑 Block Reason:]]></text>
            </staticText>
            
            <textField isStretchWithOverflow="true">
                <reportElement x="120" y="210" width="415" height="15" forecolor="#DC2626"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{blockReason} != null && !$F{blockReason}.isEmpty() ? $F{blockReason} : "No specific block reason - Transaction processed normally"]]></textFieldExpression>
            </textField>
            
            <!-- Action Status -->
            <staticText>
                <reportElement x="15" y="230" width="100" height="12" forecolor="#374151"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[⚡ Action Taken:]]></text>
            </staticText>
            
            <!-- Dynamic Action Status Badge -->
            <rectangle>
                <reportElement x="120" y="229" width="70" height="14" backcolor="#10B981">
                    <printWhenExpression><![CDATA[$F{actionStatus} != null && $F{actionStatus}.equals("APPROVED")]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            <rectangle>
                <reportElement x="120" y="229" width="70" height="14" backcolor="#EF4444">
                    <printWhenExpression><![CDATA[$F{actionStatus} != null && $F{actionStatus}.equals("BLOCKED")]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            <rectangle>
                <reportElement x="120" y="229" width="70" height="14" backcolor="#F59E0B">
                    <printWhenExpression><![CDATA[$F{actionStatus} != null && $F{actionStatus}.equals("REVIEW")]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            <textField>
                <reportElement x="125" y="230" width="60" height="12" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{actionStatus} != null ? $F{actionStatus} : "N/A"]]></textFieldExpression>
            </textField>
            
            <!-- Additional Rules Information -->
            <staticText>
                <reportElement x="15" y="250" width="120" height="12" forecolor="#374151"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[📋 All Rules Evaluated:]]></text>
            </staticText>
            
            <textField isStretchWithOverflow="true">
                <reportElement x="140" y="250" width="395" height="15" forecolor="#6B7280"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{allFiredRules} != null && !$F{allFiredRules}.isEmpty() ? $F{allFiredRules} : "Standard rule evaluation completed"]]></textFieldExpression>
            </textField>
            
            <!-- Separator Line -->
            <line>
                <reportElement x="0" y="275" width="555" height="2"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#E5E7EB"/>
                </graphicElement>
            </line>
        </band>
    </detail>

    <pageFooter>
        <band height="40" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="5" width="555" height="30" backcolor="#F8FAFC"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#E2E8F0"/>
                </graphicElement>
            </rectangle>
            
            <textField>
                <reportElement x="10" y="15" width="100" height="15" forecolor="#6B7280"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["📄 Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            
            <textField evaluationTime="Report">
                <reportElement x="445" y="15" width="100" height="15" forecolor="#6B7280"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[" of " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="120" y="15" width="315" height="15" forecolor="#6B7280"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[🔒 Confidential - Comprehensive AI Rule Analysis Report]]></text>
            </staticText>
        </band>
    </pageFooter>

</jasperReport>