<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ai_rule_detailed_analysis" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <property name="ireport.zoom" value="1.0"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>

    <parameter name="reportTitle" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["Detailed AI Rule Analysis Report"]]></defaultValueExpression>
    </parameter>
    <parameter name="generatedDate" class="java.lang.String" isForPrompting="false"/>
    <parameter name="totalTransactions" class="java.lang.Integer" isForPrompting="false"/>
    <parameter name="flaggedTransactions" class="java.lang.Integer" isForPrompting="false"/>
    <parameter name="averageRiskScore" class="java.lang.Double" isForPrompting="false"/>
    <parameter name="highRiskCount" class="java.lang.Integer" isForPrompting="false"/>
    <parameter name="mediumRiskCount" class="java.lang.Integer" isForPrompting="false"/>
    <parameter name="lowRiskCount" class="java.lang.Integer" isForPrompting="false"/>

    <field name="transactionId" class="java.lang.Long"/>
    <field name="transactionUuid" class="java.lang.String"/>
    <field name="amount" class="java.lang.Double"/>
    <field name="pan" class="java.lang.String"/>
    <field name="originalRiskLevel" class="java.lang.String"/>
    <field name="newRiskLevel" class="java.lang.String"/>
    <field name="firedAIRules" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    <field name="transactionDate" class="java.lang.String"/>
    <field name="riskScore" class="java.lang.Double"/>
    <field name="fraudPercentage" class="java.lang.Double"/>
    <field name="actionStatus" class="java.lang.String"/>
    <field name="blockReason" class="java.lang.String"/>
    <field name="allFiredRules" class="java.lang.String"/>

    <background>
        <band splitType="Stretch"/>
    </background>

    <title>
        <band height="120" splitType="Stretch">
            <!-- Header Background -->
            <rectangle>
                <reportElement x="0" y="0" width="555" height="70" backcolor="#1E3A8A"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            
            <staticText>
                <reportElement x="20" y="10" width="515" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Fraud Management System]]></text>
            </staticText>
            
            <textField>
                <reportElement x="20" y="35" width="515" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="0" y="80" width="555" height="15"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated on: " + $P{generatedDate}]]></textFieldExpression>
            </textField>
            
            <line>
                <reportElement x="0" y="105" width="555" height="2"/>
                <graphicElement>
                    <pen lineWidth="2.0" lineColor="#1E3A8A"/>
                </graphicElement>
            </line>
        </band>
    </title>

    <pageHeader>
        <band height="80" splitType="Stretch">
            <!-- Summary Statistics -->
            <rectangle>
                <reportElement x="0" y="10" width="555" height="60" backcolor="#F8FAFC"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#E2E8F0"/>
                </graphicElement>
            </rectangle>
            
            <staticText>
                <reportElement x="10" y="15" width="535" height="15" forecolor="#1E3A8A"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Analysis Summary]]></text>
            </staticText>
            
            <textField>
                <reportElement x="10" y="35" width="130" height="12"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Total Transactions: " + $P{totalTransactions}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="145" y="35" width="130" height="12"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Flagged: " + $P{flaggedTransactions}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="280" y="35" width="130" height="12"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Avg Risk Score: " + $P{averageRiskScore}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="10" y="50" width="100" height="12" forecolor="#DC2626"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["High Risk: " + $P{highRiskCount}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="115" y="50" width="100" height="12" forecolor="#D97706"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Medium Risk: " + $P{mediumRiskCount}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="220" y="50" width="100" height="12" forecolor="#059669"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Low Risk: " + $P{lowRiskCount}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <detail>
        <band height="200" splitType="Stretch">
            <!-- Transaction Card -->
            <rectangle>
                <reportElement x="0" y="5" width="555" height="190" backcolor="#FFFFFF"/>
                <graphicElement>
                    <pen lineWidth="1.5" lineColor="#E5E7EB"/>
                </graphicElement>
            </rectangle>
            
            <!-- Transaction Header -->
            <rectangle>
                <reportElement x="0" y="5" width="555" height="25" backcolor="#3B82F6"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            
            <textField>
                <reportElement x="10" y="10" width="200" height="15" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Transaction ID: " + $F{transactionId}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="220" y="10" width="150" height="15" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["UUID: " + ($F{transactionUuid} != null ? $F{transactionUuid}.substring(0, Math.min(8, $F{transactionUuid}.length())) + "..." : "N/A")]]></textFieldExpression>
            </textField>
            
            <!-- Status Badge -->
            <rectangle>
                <reportElement x="480" y="8" width="65" height="14" backcolor="#EF4444"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            <textField>
                <reportElement x="485" y="9" width="55" height="12" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            
            <!-- Basic Transaction Info -->
            <staticText>
                <reportElement x="10" y="40" width="535" height="12" forecolor="#374151"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Transaction Details]]></text>
            </staticText>
            
            <textField pattern="$#,##0.00">
                <reportElement x="10" y="55" width="120" height="12"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Amount: " + $F{amount}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="140" y="55" width="150" height="12"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["PAN: " + ($F{pan} != null ? $F{pan}.substring(0, Math.min(4, $F{pan}.length())) + "****" + $F{pan}.substring(Math.max(0, $F{pan}.length()-4)) : "N/A")]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="300" y="55" width="120" height="12"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Date: " + $F{transactionDate}]]></textFieldExpression>
            </textField>
            
            <!-- Risk Assessment -->
            <staticText>
                <reportElement x="10" y="75" width="535" height="12" forecolor="#374151"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Risk Assessment]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="10" y="90" width="80" height="12"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <text><![CDATA[Original Risk:]]></text>
            </staticText>
            
            <!-- Original Risk Badge -->
            <rectangle>
                <reportElement x="95" y="89" width="50" height="14" backcolor="#10B981"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            <textField>
                <reportElement x="100" y="90" width="40" height="12" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{originalRiskLevel}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="160" y="90" width="60" height="12"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <text><![CDATA[New Risk:]]></text>
            </staticText>
            
            <!-- New Risk Badge -->
            <rectangle>
                <reportElement x="225" y="89" width="50" height="14" backcolor="#EF4444"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            <textField>
                <reportElement x="230" y="90" width="40" height="12" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{newRiskLevel}]]></textFieldExpression>
            </textField>
            
            <textField pattern="#,##0.00">
                <reportElement x="290" y="90" width="80" height="12"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Risk Score: " + $F{riskScore}]]></textFieldExpression>
            </textField>
            
            <textField pattern="#,##0.00'%'">
                <reportElement x="380" y="90" width="100" height="12"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Fraud %: " + $F{fraudPercentage}]]></textFieldExpression>
            </textField>
            
            <!-- Fired Rules Section -->
            <staticText>
                <reportElement x="10" y="110" width="535" height="12" forecolor="#DC2626"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Fired AI Rules & Analysis]]></text>
            </staticText>
            
            <!-- Fired Rules Box -->
            <rectangle>
                <reportElement x="10" y="125" width="535" height="25" backcolor="#FEF2F2"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#FECACA"/>
                </graphicElement>
            </rectangle>
            
            <textField isStretchWithOverflow="true">
                <reportElement x="15" y="128" width="525" height="19" forecolor="#991B1B"/>
                <textElement verticalAlignment="Top">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Rules: " + ($F{firedAIRules} != null && !$F{firedAIRules}.isEmpty() ? $F{firedAIRules} : "No rules fired")]]></textFieldExpression>
            </textField>
            
            <!-- Block Reason Section -->
            <staticText>
                <reportElement x="10" y="155" width="100" height="12" forecolor="#374151"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Block Reason:]]></text>
            </staticText>
            
            <textField isStretchWithOverflow="true">
                <reportElement x="115" y="155" width="430" height="12" forecolor="#DC2626"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{blockReason} != null ? $F{blockReason} : "No block reason specified"]]></textFieldExpression>
            </textField>
            
            <!-- Action Status -->
            <staticText>
                <reportElement x="10" y="170" width="100" height="12" forecolor="#374151"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Action Status:]]></text>
            </staticText>
            
            <!-- Action Status Badge -->
            <rectangle>
                <reportElement x="115" y="169" width="60" height="14" backcolor="#7C3AED"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            <textField>
                <reportElement x="120" y="170" width="50" height="12" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{actionStatus} != null ? $F{actionStatus} : "N/A"]]></textFieldExpression>
            </textField>
            
            <!-- Separator Line -->
            <line>
                <reportElement x="0" y="195" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#E5E7EB"/>
                </graphicElement>
            </line>
        </band>
    </detail>

    <pageFooter>
        <band height="30" splitType="Stretch">
            <line>
                <reportElement x="0" y="5" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineColor="#D1D5DB"/>
                </graphicElement>
            </line>
            <textField>
                <reportElement x="0" y="10" width="100" height="15" forecolor="#6B7280"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="455" y="10" width="100" height="15" forecolor="#6B7280"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[" of " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="150" y="10" width="255" height="15" forecolor="#6B7280"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <text><![CDATA[Confidential - Detailed AI Rule Analysis Report]]></text>
            </staticText>
        </band>
    </pageFooter>

</jasperReport>