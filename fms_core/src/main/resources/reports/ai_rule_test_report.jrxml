<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ai_rule_test_report" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <property name="ireport.zoom" value="1.0"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>

    <parameter name="reportTitle" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["AI Rule Testing & Validation Report"]]></defaultValueExpression>
    </parameter>
    <parameter name="generatedDate" class="java.lang.String" isForPrompting="false"/>
    <parameter name="totalTransactions" class="java.lang.Integer" isForPrompting="false"/>
    <parameter name="flaggedTransactions" class="java.lang.Integer" isForPrompting="false"/>
    <parameter name="averageRiskScore" class="java.lang.Double" isForPrompting="false"/>
    <parameter name="highRiskCount" class="java.lang.Integer" isForPrompting="false"/>
    <parameter name="mediumRiskCount" class="java.lang.Integer" isForPrompting="false"/>
    <parameter name="lowRiskCount" class="java.lang.Integer" isForPrompting="false"/>

    <field name="transactionId" class="java.lang.Long"/>
    <field name="transactionUuid" class="java.lang.String"/>
    <field name="amount" class="java.lang.Double"/>
    <field name="pan" class="java.lang.String"/>
    <field name="originalRiskLevel" class="java.lang.String"/>
    <field name="newRiskLevel" class="java.lang.String"/>
    <field name="firedAIRules" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    <field name="transactionDate" class="java.lang.String"/>
    <field name="riskScore" class="java.lang.Double"/>
    <field name="fraudPercentage" class="java.lang.Double"/>
    <field name="actionStatus" class="java.lang.String"/>

    <background>
        <band splitType="Stretch"/>
    </background>

    <title>
        <band height="120" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="0" width="555" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[Fraud Management System]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="40" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="70" width="555" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated on: " + $P{generatedDate}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="110" width="555" height="1"/>
            </line>
        </band>
    </title>

    <pageHeader>
        <band height="100" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="10" width="555" height="20"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[Executive Summary]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="35" width="275" height="15"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Total Transactions Analyzed: " + $P{totalTransactions}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="280" y="35" width="275" height="15"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Flagged Transactions: " + $P{flaggedTransactions}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="55" width="275" height="15"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Average Risk Score: " + $P{averageRiskScore}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="75" width="185" height="15"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["High Risk: " + $P{highRiskCount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="185" y="75" width="185" height="15"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Medium Risk: " + $P{mediumRiskCount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="370" y="75" width="185" height="15"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Low Risk: " + $P{lowRiskCount}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <columnHeader>
        <band height="30" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="0" width="60" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Transaction ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="60" y="0" width="70" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Amount]]></text>
            </staticText>
            <staticText>
                <reportElement x="130" y="0" width="80" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[PAN]]></text>
            </staticText>
            <staticText>
                <reportElement x="210" y="0" width="70" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Original Risk]]></text>
            </staticText>
            <staticText>
                <reportElement x="280" y="0" width="70" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[New Risk]]></text>
            </staticText>
            <staticText>
                <reportElement x="350" y="0" width="60" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Risk Score]]></text>
            </staticText>
            <staticText>
                <reportElement x="410" y="0" width="70" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Fraud %]]></text>
            </staticText>
            <staticText>
                <reportElement x="480" y="0" width="75" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="29" width="555" height="1"/>
            </line>
        </band>
    </columnHeader>

    <detail>
        <band height="20" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="60" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{transactionId}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="60" y="0" width="70" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="130" y="0" width="80" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{pan} != null ? $F{pan}.substring(0, Math.min(4, $F{pan}.length())) + "****" + $F{pan}.substring(Math.max(0, $F{pan}.length()-4)) : "N/A"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="210" y="0" width="70" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{originalRiskLevel}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="280" y="0" width="70" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{newRiskLevel}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="350" y="0" width="60" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{riskScore}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="410" y="0" width="70" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{fraudPercentage}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="480" y="0" width="75" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="30" splitType="Stretch">
            <textField>
                <reportElement x="0" y="10" width="100" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="455" y="10" width="100" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[" of " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>