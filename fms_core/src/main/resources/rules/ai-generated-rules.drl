import net.com.fms_core.dto.message.IsoMessageDTO;

rule "AI_Generated_micro_transaction_0"
when
    $t : IsoMessageDTO(amount > 5002.89 , amount > 2021.80 , amount > 999.58 , amount > 499.08 , amount > 65.08)
then
    $t.setRiskLevel("HIGH");
    $t.setFlaggedForReview(true);
    $t.setRuleFired(true);
    $t.setRuleName("micro_transaction");
    $t.setFiredRule("Generated by AI");
    $t.setRiskScore(7.0);
end

